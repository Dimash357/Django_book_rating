# Copy to .env and fill in. Real environment variables take precedence.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_DB_PATH=/absolute/path/to/db.sqlite3

# TMDB: v3 API key or v4 "API Read Access Token"
TMDB_API_KEY=
TMDB_LANGUAGE=ru-RU

# Google Gemini (AI recommendations). Leave empty to use the offline fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=20
AI_MAX_CANDIDATES=300
AI_CACHE_SECONDS=3600
